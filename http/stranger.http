### Coterie — a signed-in user who is not at the table
#
# Knows every id (they leaked in a screenshot). Holds no membership.

### Cannot read the chronicle
GET {{endpoint}}/tablesdb/{{db}}/tables/chronicles/rows/{{chronicleId}}
X-Appwrite-Project: {{project}}
X-Appwrite-JWT: {{jwtStranger}}

> {%
  client.test("stranger cannot read the chronicle", () => {
    client.assert(response.status === 404, `expected 404, got ${response.status}`);
  });
%}

### Cannot read a table roll
GET {{endpoint}}/tablesdb/{{db}}/tables/rolls/rows/{{tableRollId}}
X-Appwrite-Project: {{project}}
X-Appwrite-JWT: {{jwtStranger}}

> {%
  client.test("stranger cannot read the roll feed", () => {
    client.assert(response.status === 404, `expected 404, got ${response.status}`);
  });
%}

### Cannot plant a presence row readable by the table
POST {{endpoint}}/tablesdb/{{db}}/tables/presence/rows
X-Appwrite-Project: {{project}}
X-Appwrite-JWT: {{jwtStranger}}
Content-Type: application/json

{ "rowId": "unique()", "data": { "chronicleId": "{{chronicleId}}", "userId": "sec-stranger", "lastSeen": "2026-01-01T00:00:00.000Z" }, "permissions": ["read(\"team:{{teamId}}\")"] }

> {%
  client.test("a client cannot grant a role it does not hold", () => {
    client.assert(response.status === 401 || response.status === 400, `expected 401/400, got ${response.status}`);
  });
%}

### Cannot create a character in the chronicle
POST {{endpoint}}/functions/character/executions
X-Appwrite-Project: {{project}}
X-Appwrite-JWT: {{jwtStranger}}
Content-Type: application/json

{ "async": false, "body": "{\"action\":\"create\",\"chronicleId\":\"{{chronicleId}}\",\"profile\":{\"name\":\"Gatecrasher\"},\"sheet\":{}}" }

> {%
  client.test("stranger cannot sit down without an invite", () => {
    client.assert(response.body.responseStatusCode === 403, `expected 403, got ${response.body.responseStatusCode}`);
  });
%}

### Cannot roll a character, and learns nothing about whether it exists
POST {{endpoint}}/functions/rollPool/executions
X-Appwrite-Project: {{project}}
X-Appwrite-JWT: {{jwtStranger}}
Content-Type: application/json

{ "async": false, "body": "{\"characterId\":\"{{playerCharacterId}}\",\"traits\":[\"dexterity\"]}" }

> {%
  client.test("stranger gets the same 403 for a real id as a fake one", () => {
    client.assert(response.body.responseStatusCode === 403, `expected 403, got ${response.body.responseStatusCode}`);
  });
%}
