### Creation: nor write a creation request directly
POST {{endpoint}}/tablesdb/{{db}}/tables/creationRequests/rows
X-Appwrite-Project: {{project}}
X-Appwrite-JWT: {{jwtPlayer}}
Content-Type: application/json

{ "rowId": "unique()", "data": { "chronicleId": "{{chronicleId}}", "ownerId": "sec-player", "profile": "{}", "sheet": "{}", "cost": "[]", "status": "pending" } }

> {%
  client.test("requests are written only by the Function", () => {
    client.assert(response.status === 401 || response.status === 403 || response.status === 404, `expected a refusal, got ${response.status}`);
  });
%}

