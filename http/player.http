{ "rowId": "{{playerCharacterId}}", "data": { "chronicleId": "{{chronicleId}}", "ownerId": "sec-player", "sheet": "{}", "status": "pending" } }

> {%
  client.test("player cannot write a proposal row", () => {
    client.assert(response.status === 401, `expected 401, got ${response.status}`);
  });
%}

