### NPCs: the Storyteller's cast is invisible to a player
GET {{endpoint}}/tablesdb/{{db}}/tables/npcs/rows?queries[]={"method":"equal","attribute":"chronicleId","values":["{{chronicleId}}"]}
X-Appwrite-Project: {{project}}
X-Appwrite-JWT: {{jwtPlayer}}

> {%
  client.test("no NPC rows reach a player", () => {
    client.assert(response.status === 200, `expected 200, got ${response.status}`);
    client.assert(response.body.total === 0, `expected 0 rows, got ${response.body.total}`);
  });
%}

