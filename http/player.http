### sealDifficulty / revealRoll / revealSecret / scene: all Storyteller-only
POST {{endpoint}}/functions/revealSecret/executions
X-Appwrite-Project: {{project}}
X-Appwrite-JWT: {{jwtPlayer}}
Content-Type: application/json

{ "async": false, "body": "{\"secretId\":\"{{secretId}}\",\"userId\":\"sec-player\"}" }

> {%
  client.test("a player cannot reveal a secret to themselves", () => {
    client.assert(response.body.responseStatusCode === 403, `expected 403, got ${response.body.responseStatusCode}`);
  });
%}

